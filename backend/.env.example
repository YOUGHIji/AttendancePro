# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:password@localhost:5432/attendancepro?schema=public"

# Server
PORT=4000

# JWT (issued by our own server after password verification)
JWT_SECRET="change-this-to-a-long-random-secret"
JWT_EXPIRES_IN="30d"

# QR session token expiry, in seconds (how long a generated attendance QR stays valid)
QR_SESSION_TTL_SECONDS=90
